# Copy to .env and adjust if you want to override the Taskfile defaults.
# No secrets belong in this file: all lab credentials live inside the VM.

# Multipass VM name
export LAB_VM_NAME=tpm-lab

# Device identity enrolled into the TPM
export LAB_DEVICE_NAME=node01

# Domain the device CA is allowed to issue for
export LAB_DOMAIN=devices.lab.local

# Vault Enterprise license file on the host (optional path override).
# Default: .vault-license in the project root. Required for vault-dev to start.
# export VAULT_LICENSE_FILE=.vault-license
